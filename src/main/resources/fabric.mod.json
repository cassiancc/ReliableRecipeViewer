{
  "schemaVersion": 1,
  "id": "rrv",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "repo": "https://github.com/cassiancc/ExtendedItemView",
    "issues": "https://github.com/cassiancc/ExtendedItemView/issues",
    "homepage": "https://modrinth.com/mod/rrv-canary",
    "sources": "https://github.com/cassiancc/ExtendedItemView"
  },
  "license": "${mod_license}",
  "icon": "assets/rrv/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "cc.cassian.rrv.fabric.FabricEntrypoint"
    ],
    "client": [
      "cc.cassian.rrv.fabric.FabricClientEntrypoint"
    ],
    "rrv": [
      "cc.cassian.rrv.common.builtin.BuiltInReliableRecipeViewerIntegration"
    ],
    "modmenu": [
      "cc.cassian.rrv.fabric.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "rrv.mixins.json",
    "rrv.fabric.mixins.json"
  ],
  "accessWidener": "${accesswidener}",
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
  }
}